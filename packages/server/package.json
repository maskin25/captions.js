{
  "name": "@captionsjs/server",
  "version": "0.1.1",
  "description": "Burn captions.js animated word-level captions into video with FFmpeg — same renderer as the browser preview, no headless browser.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/maskin25/captions.js",
    "directory": "packages/server"
  },
  "homepage": "https://github.com/maskin25/captions.js#readme",
  "keywords": [
    "captions",
    "subtitles",
    "burn-in",
    "ffmpeg",
    "video",
    "animated-captions",
    "cli",
    "skia-canvas"
  ],
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "bin": {
    "captionsjs": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/lib.d.ts",
      "default": "./dist/lib.js"
    },
    "./package.json": "./package.json"
  },
  "main": "dist/lib.js",
  "types": "dist/lib.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "rimraf dist && tsc -p tsconfig.json && node -e \"require('fs').chmodSync('dist/cli.js',0o755)\"",
    "start": "node dist/index.js",
    "test": "node test/animate.test.mjs && node test/cli.test.mjs",
    "clean": "rimraf dist",
    "prepublishOnly": "pnpm run build",
    "docker:build": "docker build -t captionsjs-server .",
    "docker:run": "docker run --rm -p 4000:4000 captionsjs-server",
    "previews": "node scripts/render-previews.mjs"
  },
  "dependencies": {
    "captions.js": "workspace:^",
    "express": "^4.19.2",
    "konva": "^10.0.8",
    "pino": "^8.17.1",
    "skia-canvas": "^3.0.8",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.19",
    "rimraf": "^5.0.5",
    "tsx": "^4.7.1",
    "typescript": "^5.3.3"
  }
}
