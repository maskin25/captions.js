{
  "name": "captions.js",
  "version": "1.1.2",
  "private": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/maskin25/captions.js"
  },
  "description": "The same caption renderer in your live browser preview and in your FFmpeg pipeline — word-level animated captions on canvas, pixel-identical, no headless browser.",
  "keywords": [
    "captions",
    "subtitles",
    "video",
    "transcription",
    "ffmpeg",
    "canvas",
    "konva",
    "burn-in",
    "animated-captions",
    "kinetic-typography",
    "word-level",
    "shorts",
    "reels",
    "tiktok",
    "client-side",
    "server-side"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts",
    "dev": "tsup src/index.ts --format esm,cjs --dts --watch",
    "prepublishOnly": "cp ../../README.md ./README.md && cp ../../LICENSE ./LICENSE && pnpm run build",
    "postpublish": "rm -f README.md LICENSE",
    "test": "node test/types-smoke.mjs"
  },
  "devDependencies": {
    "@types/object-hash": "^3.0.6",
    "tsup": "^8.0.0",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "konva": "^10.0.2",
    "object-hash": "^3.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}
